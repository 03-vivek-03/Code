# Shell scripts and the Makefile must use LF even when checked out on Windows.
# A CRLF server_run.sh fails on the run host with `$'': command not found`,
# which is an obscure way to discover a line-ending problem at launch time.
*.sh   text eol=lf
Makefile text eol=lf
*.py   text eol=lf

# Trace corpora are newline-delimited JSON; never touch their endings.
*.jsonl -text
